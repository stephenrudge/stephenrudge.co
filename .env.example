# Sanity CMS (required for stories + Studio at /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Viewer token — Sanity → API → Tokens
SANITY_API_READ_TOKEN=
# Shared secret for /api/revalidate webhook
SANITY_REVALIDATE_SECRET=
# Public site URL used by Studio Presentation preview
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio

# Legacy local admin (now redirects to /studio)
ADMIN_PASSWORD=changeme
ADMIN_SECRET=replace-with-a-long-random-string

# Optional: GitHub / Cloudinary leftovers from the previous MDX admin
GITHUB_TOKEN=
GITHUB_REPO=stephenrudge/stephenrudge.co
GITHUB_BRANCH=main
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stephenrudge/covers
