# Admin (password login at /admin — session lasts 30 days)
ADMIN_PASSWORD=changeme
ADMIN_SECRET=replace-with-a-long-random-string

# Supabase (free) — Project Settings → API
# Also run supabase/migrations/001_posts.sql and 002_contact_messages.sql
# in the SQL Editor once.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=

# Contact notifications via Resend (free tier) — https://resend.com
RESEND_API_KEY=
# Inbox that receives contact form emails
CONTACT_NOTIFY_EMAIL=
# Optional: shown on /contact + used as notify fallback
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional from address after you verify your domain in Resend
# Default for testing: Stephen Rudge <onboarding@resend.dev>
RESEND_FROM_EMAIL=

# Optional tip jar (Buy Me a Coffee, Ko-fi, PayPal.me, Venmo, etc.)
NEXT_PUBLIC_TIP_URL=
NEXT_PUBLIC_TIP_LABEL=Send coffee or gas money

# Cloudinary (free) — cover + inline photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stephenrudge/covers

# Optional site URL
NEXT_PUBLIC_SITE_URL=https://www.stephenrudge.com

# Optional: override portfolio iframe with a separate deployed demo URL.
# By default Hearth & Ember is bundled at /demos/hearth-ember-co/ (no local server).
# Rebuild bundle after hearth changes: npm run portfolio:hearth
NEXT_PUBLIC_HEARTH_EMBER_DEMO_URL=

# Cloudflare Pages (free host): connect this GitHub repo, set the env vars above,
# add custom domains stephenrudge.com + www, then point DNS to Cloudflare.
