# Admin (password login at /admin — session lasts 30 days)
ADMIN_PASSWORD=changeme
ADMIN_SECRET=replace-with-a-long-random-string

# Supabase (free) — Project Settings → API
# Also run supabase/migrations/001_posts.sql and 002_contact_messages.sql
# in the SQL Editor once.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=

# Optional public contact email shown on /contact
NEXT_PUBLIC_CONTACT_EMAIL=

# Cloudinary (free) — cover + inline photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stephenrudge/covers

# Optional site URL
NEXT_PUBLIC_SITE_URL=https://www.stephenrudge.com

# Cloudflare Pages (free host): connect this GitHub repo, set the env vars above,
# add custom domains stephenrudge.com + www, then point DNS to Cloudflare.
