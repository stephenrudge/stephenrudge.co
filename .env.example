ADMIN_PASSWORD=changeme
ADMIN_SECRET=replace-with-a-long-random-string

# Required on Vercel so admin can create/edit/delete stories
# Create a fine-grained PAT with Contents: Read and write on this repo
GITHUB_TOKEN=
GITHUB_REPO=stephenrudge/stephenrudge.co
GITHUB_BRANCH=main

# Cloudinary cover image uploads (required on Vercel)
# Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stephenrudge/covers
